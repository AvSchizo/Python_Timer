			fontFamily = preferences["defaultFontFamily"]
		else:
			fontFamily = inFont

		# inFontTotal is whole pygame font object
		if inFontTotal == None:
			try:
				self.font = pygame.font.Font(fontFamily, inFontSize)
			except:
				self.font = pygame.font.Font(None, inFontSize)
		else:
			self.font = inFontTotal









